<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_horizontal" android:padding="16dp">
    <TextView style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Scan with your banking app" android:layout_marginBottom="12dp"/>
    <ph.tindahan.market.QrView android:id="@+id/qr_image" android:layout_width="240dp" android:layout_height="240dp"/>
    <TextView android:id="@+id/qr_amount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:textSize="20sp" android:textStyle="bold" android:textColor="#1D2433"/>
    <Button android:id="@+id/qr_paid" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="I have paid"/>
    <Button android:id="@+id/qr_cancel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Cancel" style="@style/BtnBorderless"/>
</LinearLayout>
