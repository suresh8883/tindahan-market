<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="brand">#1F6F4A</color>
    <color name="brand_dark">#15523A</color>
    <color name="accent">#E0A100</color>
    <color name="muted">#5B6475</color>
    <color name="error">#B3261E</color>
    <style name="AppTheme" parent="android:Theme.Material.Light.DarkActionBar">
        <item name="android:colorPrimary">@color/brand</item>
        <item name="android:colorPrimaryDark">@color/brand_dark</item>
        <item name="android:colorAccent">@color/brand</item>
        <item name="android:buttonStyle">@style/Btn</item>
    </style>
    <style name="Btn" parent="android:Widget.Material.Button"><item name="android:textAllCaps">false</item></style>
    <style name="BtnBorderless" parent="android:Widget.Material.Button.Borderless"><item name="android:textAllCaps">false</item></style>
    <style name="Label"><item name="android:textSize">16sp</item><item name="android:textColor">#1D2433</item></style>
    <style name="Error"><item name="android:textSize">14sp</item><item name="android:textColor">@color/error</item><item name="android:visibility">gone</item></style>
</resources>
