{
  "name": "tindahan-market-lab",
  "version": "1.0.0",
  "private": true,
  "description": "Hands-on lab repository: a tiny Philippine e-commerce store and a Playwright suite to steer with an AI testing agent.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node vendor/tindahan-server.cjs",
    "test": "playwright test",
    "typecheck": "tsc --noEmit",
    "browser:install": "playwright install --only-shell chromium",
    "doctor": "node scripts/doctor.mjs",
    "defects": "node scripts/defects.mjs",
    "check:rules": "node scripts/check-rules.mjs",
    "check:tk8": "node scripts/check-lab1.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
